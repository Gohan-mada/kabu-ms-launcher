<Window x:Class="KabuMSLauncher.MailSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="メール通知の設定"
        Height="520" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgSoft}"
        FontFamily="Yu Gothic UI, Meiryo, sans-serif"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandPrimary}" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/logo.png" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="メール通知の設定" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,20,24,0">
            <TextBlock FontSize="13" Foreground="{StaticResource TextDark}" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="通信の切断から自動で再接続したとき、または再接続が途中で止まったときに、メールでお知らせします。"/>

            <!-- 未登録のとき -->
            <StackPanel x:Name="RegisterPanel">
                <TextBlock Text="メールアドレス" Foreground="{StaticResource TextDark}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="EmailBox" Style="{StaticResource TextField}" Grid.Column="0"/>
                    <Button x:Name="SendCodeButton" Grid.Column="1" Content="確認コードを送る" Margin="8,0,0,0" Padding="12,0"
                            Background="{StaticResource BrandPrimary}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="SendCodeButton_Click"/>
                </Grid>

                <StackPanel x:Name="CodePanel" Visibility="Collapsed">
                    <TextBlock Text="メールに届いた6けたの確認コード" Foreground="{StaticResource TextDark}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CodeBox" Style="{StaticResource TextField}" Grid.Column="0" MaxLength="6"/>
                        <Button x:Name="VerifyButton" Grid.Column="1" Content="登録する" Margin="8,0,0,0" Padding="22,0"
                                Background="{StaticResource BrandAccent}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="VerifyButton_Click"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- 登録済みのとき -->
            <StackPanel x:Name="RegisteredPanel" Visibility="Collapsed">
                <TextBlock Text="お知らせの送り先" Foreground="{StaticResource TextDark}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="RegisteredEmailText" FontSize="15" Foreground="{StaticResource TextDark}" Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button x:Name="TestButton" Content="試しに送る" Padding="14,6" Background="{StaticResource BrandPrimary}" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="TestButton_Click"/>
                    <Button x:Name="UnregisterButton" Content="登録を解除する" Padding="14,6" Margin="8,0,0,0" Background="Transparent"
                            Foreground="{StaticResource BrandPrimary}" BorderBrush="{StaticResource BrandPrimary}" BorderThickness="1" Cursor="Hand" Click="UnregisterButton_Click"/>
                </StackPanel>
                <CheckBox x:Name="NotifyOnSuccessCheck" Content="再接続できたときも知らせる" Foreground="{StaticResource TextDark}"
                          Checked="NotifyOnSuccessCheck_Changed" Unchecked="NotifyOnSuccessCheck_Changed"/>
                <TextBlock Margin="22,2,0,0" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                           Text="チェックを外すと、再接続が途中で止まったときだけ知らせます。"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="16,12">
            <Button Content="閉じる" Width="100" Height="32" HorizontalAlignment="Right" Click="CloseButton_Click"
                    Background="{StaticResource BrandPrimary}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Border>
    </Grid>
</Window>
